{"budget-vs-actual":{"id":"budget-vs-actual","title":"Budget vs actual","version":3,"params":{"month":"2026-10"},"data":{"lines":{"from":"budget_lines"},"months":{"from":"months","sort":["month"]},"cur":{"from":"months","where":"row.month == params.month"}},"computed":{"total_limit":"sum(data.lines.map(l, l.limit))","total_avg":"sum(data.lines.map(l, l.avg))","gap":"computed.total_avg - computed.total_limit","over":"size(data.lines.filter(l, l.avg > l.limit))","month_total":"data.cur[0].total"},"pages":[{"id":"main","title":"Overview","layout":[{"cols":[{"span":3,"component":"k_budget"},{"span":3,"component":"k_avg"},{"span":3,"component":"k_gap"},{"span":3,"component":"k_over"}]},{"cols":[{"span":7,"component":"bars"},{"span":5,"component":"monthly"}]},{"cols":[{"span":8,"component":"tbl"},{"span":4,"component":"note"}]}]}],"components":[{"id":"k_budget","type":"kpi","title":"Budget","value":"computed.total_limit","format":"eur0","sub":"'all-in, ' + string(size(data.lines)) + ' lines'"},{"id":"k_avg","type":"kpi","title":"Current habits","value":"computed.total_avg","format":"eur0","sub":"'sum of 6-month line averages'","tone":"computed.total_avg > computed.total_limit ? 'neg' : 'ok'"},{"id":"k_gap","type":"kpi","title":"Gap to budget","value":"computed.gap","format":"eur0","sub":"string(round(abs(pct(computed.gap, computed.total_limit)), 0)) + (computed.gap > 0 ? '% over' : computed.gap < 0 ? '% under' : '% of budget')","tone":"computed.gap > 0 ? 'neg' : 'ok'"},{"id":"k_over","type":"kpi","title":"Lines over limit","value":"computed.over","format":"int","sub":"'of ' + string(size(data.lines))"},{"id":"bars","type":"budget_bars","title":"Limit vs 6-month average","rows":"lines","label":"row.name","actual":"row.avg","limit":"row.limit"},{"id":"monthly","type":"chart","title":"All-in spend by month","mark":"bar","rows":"months","encoding":{"x":{"field":"month"},"y":{"expr":"row.total"}},"rule":{"y":"computed.total_limit","label":"'budget'"}},{"id":"tbl","type":"table","title":"Lines","rows":"lines","columns":[{"label":"Line","value":"row.name"},{"label":"Limit","value":"row.limit","format":"eur0"},{"label":"Actual","value":"row.oct","format":"eur0"},{"label":"6-mo avg","value":"row.avg","format":"eur0"},{"label":"Gap","value":"row.avg - row.limit","format":"eur0","tone":"row.avg > row.limit ? 'neg' : 'ok'"}]},{"id":"note","type":"text","title":"Note","md":"Budget limits and spending come from your journal. Edit budget lines or assumptions to recompute this dashboard."}]},"forecast":{"id":"forecast","title":"Forecast & scenarios","version":1,"params":{},"data":{"a":{"from":"table:assumptions","as":"map","key":"key","value":"value"},"proj":{"from":"range","n":"int(data.a.horizon) + 1","derive":{"m":"row.i","net":"data.a.start_net_usd + row.i * (data.a.income_usd - data.a.spend_eur * data.a.eurusd) + data.a.gold_g * data.a.gold_usd_g * data.a.gold_shock_pct / 100.0"}},"sc":{"from":"scenarios"}},"computed":{"burn_usd":"data.a.spend_eur * data.a.eurusd","end_net":"data.proj[size(data.proj) - 1].net","runway":"computed.burn_usd > 0 ? (data.a.start_net_usd + data.a.gold_g * data.a.gold_usd_g * data.a.gold_shock_pct / 100.0) / computed.burn_usd : 0.0","gold_value":"data.a.gold_g * data.a.gold_usd_g * (1.0 + data.a.gold_shock_pct / 100.0)"},"pages":[{"id":"main","title":"Overview","layout":[{"cols":[{"span":3,"component":"f_burn"},{"span":3,"component":"f_end"},{"span":3,"component":"f_run"},{"span":3,"component":"f_gold"}]},{"cols":[{"span":7,"component":"f_chart"},{"span":5,"component":"f_cmp"}]}]}],"components":[{"id":"f_burn","type":"kpi","title":"Monthly burn","value":"computed.burn_usd","format":"usd0","sub":"eur(data.a.spend_eur) + ' at ' + string(round(data.a.eurusd, 4))"},{"id":"f_end","type":"kpi","title":"Net worth at horizon","value":"computed.end_net","format":"usd0","sub":"'in ' + string(int(data.a.horizon)) + ' months'"},{"id":"f_run","type":"kpi","title":"Runway, no income","value":"computed.burn_usd > 0 ? computed.runwa