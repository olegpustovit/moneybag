MONEYBAG_LISTEN=127.0.0.1:6459
MONEYBAG_PUBLIC_URL=https://moneybag.microapps.space
MONEYBAG_MONGO_URI=mongodb://127.0.0.1:27017/moneybag
MONEYBAG_MONGO_DB=moneybag
MONEYBAG_LOG_FORMAT=json
# Keep legacy until the SPA is ready; set to spa to test the staged frontend.
MONEYBAG_UI=legacy
# Generate once: openssl rand -base64 32. Preserve this key across deployments.
MONEYBAG_SECRET_KEY=
# First-owner setup; blank disables /setup. Remove after creating the owner.
MONEYBAG_SETUP_TOKEN=
# Comma-separated toolsets; empty enables all.
MONEYBAG_TOOLSETS=
MONEYBAG_CHROMIUM_BIN=/opt/google/chrome/chrome
