      "css": ".ds-draft{font:500 11px var(--mono,ui-monospace,monospace);border:1px solid #a16f00;padding:1px 6px;color:#946600;border-radius:0}:host-context([data-theme=dark]) .ds-draft{border-color:var(--c1,#f5c242);color:var(--c1,#f5c242)}@media(prefers-color-scheme:dark){:host-context(:root:not([data-theme=light])) .ds-draft{border-color:var(--c1,#f5c242);color:var(--c1,#f5c242)}}"
