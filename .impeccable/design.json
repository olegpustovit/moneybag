    },
    {
      "name": "Data Grid",
      "kind": "custom",
      "refersTo": "data-grid",
      "description": "Editable paper cells and recessed calculated cells with local scrolling.",
      "html": "<div class=\"ds-grid\" role=\"region\" tabindex=\"0\" aria-label=\"Example budget table\"><table class=\"ds-table\"><thead><tr><th scope=\"col\">Category</th><th scope=\"col\">Limit</th></tr></thead><tbody><tr><td class=\"ds-edit\" contenteditable=\"plaintext-only\" aria-label=\"Edit category\" tabindex=\"0\">Example</td><td class=\"ds-calc\" tabindex=\"0\">€100</td></tr></tbody></table></div>",
      "css": ".ds-grid{border:1px solid var(--bd,#e4e5e8);background:var(--paper,#ffffff);overflow-x:auto;color:var(--text,#111214)}.ds-table{border-collapse:collapse;width:100%;font:13.5px/1.6 var(--font,system-ui,sans-serif);font-variant-numeric:tabular-nums}.ds-table th,.ds-table td{border-top:1px solid var(--bd2,#efeff1);border-right:1px solid var(--bd2,#efeff1);padding:7px 10px;text-align:left}.ds-table th{border-top:0;background:var(--sunk,#f6f6f7);font:600 11px var(--mono,ui-monospace,monospace);letter-spacing:.05em;text-transform:uppercase;color:var(--text3,#646a73)}.ds-edit{background:var(--paper,#ffffff);outline:none;cursor:text}.ds-edit:focus{box-shadow:inset 0 0 0 2px var(--focus,#2f6bff)}.ds-calc{background:var(--sunk,#f6f6f7);color:var(--text2,#55595f);text-align:right!important}.ds-grid:focus-visible,.ds-calc:focus-visible{outline:2px solid var(--focus,#2f6bff);outline-offset:3px;}"
    },
    {
      "name": "Chart Data Disclosure",
      "kind": "custom",
      "refersTo": "chart",
      "description": "Native disclosure exposes the chart values through a captioned table.",
      "html": "<details class=\"ds-chart-data\"><summary class=\"ds-chart-summary\">View chart data</summary><div class=\"ds-chart-table-region\" tabindex=\"0\" role=\"region\" aria-label=\"Example chart data\"><table class=\"ds-chart-table\"><caption>Example chart data</caption><thead><tr><th scope=\"col\">Period</th><th scope=\"col\">Value</th></tr></thead><tbody><tr><td>Example month</td><td>100</td></tr></tbody></table></div></details>",
      "css": ".ds-chart-data{margin-top:12px;font:12px/1.6 var(--font,system-ui,sans-serif);color:var(--text,#111214)}.ds-chart-summary{cursor:pointer;color:var(--text2,#55595f);padding:4px 0}.ds-chart-summary:focus-visible,.ds-chart-table-region:focus-visible{outline:2px solid var(--focus,#2f6bff);outline-offset:3px;}.ds-chart-table-region{border:1px solid var(--bd,#e4e5e8);background:var(--paper,#ffffff);overflow-x:auto}.ds-chart-table{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}.ds-chart-table caption{text-align:left;padding:8px 12px;color:var(--text2,#55595f)}.ds-chart-table th,.ds-chart-table td{padding:9px 14px;text-align:left;vertical-align:top;border-top:1px solid var(--bd2,#efeff1)}.ds-chart-table th{border-top:0;font:600 11px var(--mono,ui-monospace,monospace);color:var(--text3,#646a73);text-transform:uppercase;letter-spacing:.05em;background:var(--sunk,#f6f6f7)}"
    }
  ],
  "narrative": {
    "northStar": "The Moneybag workspace",
    "overview": "The Moneybag workspace is square, quiet and dense: a practical finance interface for repeated reading, editing and comparison. Its visual authority is the supplied Moneybag artifact and the durable brand commitments in PRODUCT.md. The implementation uses flat paper and recessed surfaces, fine shared borders, compact controls and restrained semantic color.\n\nThe same workspace survives light, dark and system themes. Responsive layouts preserve task access with a scrolling workspace navigation, single-column panels and locally scrolling data. System sans serves interface text; system monospace distinguishes operational labels, identifiers and code. There is no separate display-type role or decorative image layer.",
    "keyCharacteristics": [
      "Square geometry and shared 1px borders.",
      "Compact system typography with tabular financial numbers.",
      "Blue chart data, green within budget, red over budget and amber drafts.",
      "Flat light/dark surfaces and visible keyboard focus.",
      "Readable mobile charts with expandable semantic data tables."
    ],
    "rules": [
      {
        "name": "The Financial Meaning Rule",
        "body": "Use green for within-limit or favorable values, red for over-limit or error values, and amber for drafts. Keep chart-series colors distinct from these status meanings.",
        "section": "colors"
      },
      {
        "name": "The Data Before Decoration Rule",
        "body": "Keep operational labels and identifiers compact and monospace; keep financial figures tabular and preserve a visible title-to-value hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Separate surfaces with tone and 1px borders. Inset active and focus indicators communicate state; they do not lift cards above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the final application theme overrides recorded in the frontmatter, including the stronger muted-text and financial-status colors.",
      "Do preserve square corners, fine shared borders and the observed compact spacing rhythm.",
      "Do keep amounts tabular and align numeric table columns to the right.",
      "Do preserve all workspace tasks on mobile through scrolling navigation and single-column panels.",
      "Do pair charts with labelled, keyboard-focusable scroll regions and expandable semantic chart-data tables.",
      "Do use synthetic records in public examples and screenshots."
    ],
    "donts": [
      "Don't add rounded cards, pill controls or decorative drop shadows to this workspace.",
      "Don't replace the pinned system body and operational type with an unrelated display identity.",
      "Don't shrink mobile charts until their labels become unreadable; retain the scrolling chart canvas.",
      "Don't communicate a financial status through color alone; retain values, labels and legends.",
      "Don't copy financial data or private reference material into public documentation."
    ]
  }
}
