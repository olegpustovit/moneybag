  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact ink-filled workspace action.",
      "html": "<button class=\"ds-button-primary\">Save draft</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--ink,#111214);padding:7px 14px;font:500 13px var(--font,system-ui,sans-serif);border-radius:0;cursor:pointer;background:var(--ink,#111214);color:var(--bg,#ffffff)}.ds-button-primary:hover{opacity:.88}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#2f6bff);outline-offset:3px;}.ds-button-primary:disabled{opacity:.5;cursor:wait}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action with the same square ink border.",
      "html": "<button class=\"ds-button-ghost\">View spec</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--ink,#111214);padding:7px 14px;font:500 13px var(--font,system-ui,sans-serif);border-radius:0;cursor:pointer;background:transparent;color:var(--text,#111214)}.ds-button-ghost:hover{opacity:.88}.ds-button-ghost:focus-visible{outline:2px solid var(--focus,#2f6bff);outline-offset:3px;}.ds-button-ghost:disabled{opacity:.5;cursor:wait}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and compact square field with focus-border feedback.",
      "html": "<label class=\"ds-field\">Name<input class=\"ds-input\" value=\"Monthly overview\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--text,#111214);font:13px var(--font,system-ui,sans-serif)}.ds-input{border:1px solid var(--bd,#e4e5e8);background:var(--paper,#ffffff);color:var(--text,#111214);padding:7px 10px;font:13px var(--font,system-ui,sans-serif);border-radius:0;caret-color:var(--c0,#2f6bff);outline:none}.ds-input:focus{border-color:var(--focus,#2f6bff)}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Recessed links with a paper active row and an inset ink stripe.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace example\"><a class=\"ds-nav-link ds-current\" href=\"#overview\" aria-current=\"page\">Monthly overview</a><a class=\"ds-nav-link\" href=\"#accounts\">Accounts</a></nav>",
      "css": ".ds-nav{background:var(--sunk,#f6f6f7);border:1px solid var(--bd,#e4e5e8);font:13.5px/1.6 var(--font,system-ui,sans-serif)}.ds-nav-link{display:flex;gap:8px;padding:5px 14px;color:var(--text2,#55595f);text-decoration:none}.ds-nav-link:hover{background:var(--hover,#f1f2f4);color:var(--text,#111214)}.ds-nav-link.ds-current{background:var(--paper,#ffffff);color:var(--text,#111214);box-shadow:inset 3px 0 0 var(--ink,#111214)}.ds-nav-link:focus-visible{outline:2px solid var(--focus,#2f6bff);outline-offset:3px;}@media(max-width:620px){.ds-nav{display:flex;overflow-x:auto}.ds-nav-link{white-space:nowrap;padding:8px 12px}.ds-nav-link.ds-current{box-shadow:inset 0 -2px 0 var(--ink,#111214)}}"
    },
    {
      "name": "Permission Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Outlined operational scope label.",
      "html": "<span class=\"ds-chip\">read</span>",
      "css": ".ds-chip{display:inline-block;font:500 11px var(--mono,ui-monospace,monospace);padding:1px 6px;border:1px solid var(--bd,#e4e5e8);color:var(--text2,#55595f);margin:1px 2px 1px 0;white-space:nowrap;border-radius:0}"
    },
    {
      "name": "Dashboard Panel",
      "kind": "card",
      "refersTo": "dashboard-panel",
      "description": "Bordered paper panel with a compact data header and tabular KPI.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-title\">Available balance</div><div class=\"ds-kpi\">€1,250</div><div class=\"ds-kpi-detail\">Synthetic example</div></section>",
      "css": ".ds-panel{border:1px solid var(--bd,#e4e5e8);background:var(--paper,#ffffff);padding:14px 16px;color:var(--text,#111214);border-radius:0;font:15px/1.6 var(--font,system-ui,sans-serif)}.ds-panel-title{font:600 11px var(--mono,ui-monospace,monospace);text-transform:uppercase;letter-spacing:.06em;color:var(--text3,#646a73);margin-bottom:8px;line-height:1.5}.ds-kpi{font-size:26px;font-weight:600;letter-spacing:-.015em;font-variant-numeric:tabular-nums}.ds-kpi-detail{font-size:12px;color:var(--text3,#646a73)}@media(max-width:1100px){.ds-panel{padding:12px}}"
    },
